{
  "name": "@abap2ui5/linter",
  "version": "0.1.0",
  "description": "Validate abap2UI5 app classes without an SAP system: the ABAP and the view it builds, checked together.",
  "type": "module",
  "bin": {
    "abap2ui5-linter": "cli.mjs",
    "abap2ui5lint": "cli.mjs"
  },
  "types": "./types.d.ts",
  "exports": {
    ".": { "types": "./types.d.ts", "default": "./lib/index.mjs" },
    "./reconstruct": { "types": "./types.d.ts", "default": "./lib/reconstruct.mjs" },
    "./properties": { "types": "./types.d.ts", "default": "./lib/properties.mjs" },
    "./render": { "types": "./types.d.ts", "default": "./lib/render.mjs" },
    "./abap-rules": { "types": "./types.d.ts", "default": "./lib/abap-rules.mjs" },
    "./findings": { "types": "./types.d.ts", "default": "./lib/findings.mjs" },
    "./config": { "types": "./types.d.ts", "default": "./lib/config.mjs" },
    "./baseline": { "types": "./types.d.ts", "default": "./lib/baseline.mjs" },
    "./report": { "types": "./types.d.ts", "default": "./lib/report.mjs" },
    "./formatters": { "types": "./types.d.ts", "default": "./lib/formatters.mjs" },
    "./schema": "./data/abap2ui5lint.schema.json"
  },
  "files": [
    "cli.mjs",
    "lib/",
    "data/",
    "scripts/generate-metadata.mjs",
    "action.yml",
    "types.d.ts",
    "README.md"
  ],
  "scripts": {
    "check": "node cli.mjs",
    "test": "node test/run.mjs",
    "generate-metadata": "node scripts/generate-metadata.mjs",
    "check-upstream": "node scripts/check-upstream.mjs",
    "generate-schema": "node scripts/generate-schema.mjs",
    "generate-rules-page": "node scripts/generate-rules-page.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5/linter.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abap2UI5/abap2UI5/issues"
  },
  "homepage": "https://github.com/abap2UI5/linter#readme",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@openui5/sap.f": "1.151.0",
    "@openui5/sap.m": "1.151.0",
    "@openui5/sap.tnt": "1.151.0",
    "@openui5/sap.ui.codeeditor": "1.151.0",
    "@openui5/sap.ui.core": "1.151.0",
    "@openui5/sap.ui.integration": "1.151.0",
    "@openui5/sap.ui.layout": "1.151.0",
    "@openui5/sap.ui.table": "1.151.0",
    "@openui5/sap.ui.unified": "1.151.0",
    "@openui5/sap.uxap": "1.151.0",
    "@openui5/themelib_sap_horizon": "1.151.0",
    "playwright": "^1.61.1"
  },
  "engines": {
    "node": ">=22"
  }
}
